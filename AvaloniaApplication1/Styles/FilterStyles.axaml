<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Archipolygo.Views">
    <!-- Included app-wide: GroupDetailView is also hosted by DetachedGroupWindow,
         and ItemClassFilterButton's checkboxes live in a Flyout popup. -->

    <Style Selector="Button.filter-toggle.active">
        <!-- Named brush rather than a Fluent accent resource, whose key/type
             varies across theme versions. -->
        <Setter Property="Background" Value="DodgerBlue"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- WrapPanel has no Spacing, so the gap is a right/bottom Margin on each item. -->
    <Style Selector="Button.filter-toggle">
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <Style Selector="WrapPanel.filter-row > ComboBox">
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <!-- Same bottom margin as the buttons, else Center puts the box 2px below their midline. -->
    <Style Selector="WrapPanel.filter-row > CheckBox">
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Set only here, never locally on the GridSplitter (a local value beats
         this style). Width comes from its 12px Grid column. -->
    <Style Selector="GridSplitter.panel-divider">
        <Setter Property="Background" Value="{DynamicResource PanelDividerBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ResizeDirection" Value="Columns"/>
    </Style>

    <Style Selector="WrapPanel.filter-row > Border.filter-separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>

    <Style Selector="Button.filter-chevron">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Button.filter-summary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="views|CollapsibleFilterBar:filtering /template/ Button#PART_SummaryButton">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="DodgerBlue"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
</Styles>
