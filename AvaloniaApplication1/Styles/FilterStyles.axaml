<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Archipolygo.Views">
    <!--
        Filter-row look shared by every view with filter buttons
        (GroupDetailView, DashboardView, ItemClassFilterButton). Included
        app-wide from App.axaml rather than a single Window's Window.Styles:
        GroupDetailView is hosted both by MainWindow and by
        DetachedGroupWindow, and ItemClassFilterButton's checkboxes live in a
        Flyout popup - declaring these on MainWindow alone (as before
        Kompakteres-Layout.md) left both of those unstyled.
    -->

    <!-- The log filter buttons (Events relevance/category, Hints) each
         get an "active" class bound to whether they represent the
         currently selected filter value (see Classes.active on each
         Button); this highlights the active one so it's unmistakable at
         a glance, independently of which Command actually changed the
         filter. -->
    <Style Selector="Button.filter-toggle.active">
        <!-- A plain named brush rather than a theme accent resource, to
             avoid relying on exactly which accent-related resource key
             the installed Fluent theme version exposes (some are Color,
             not IBrush, and aren't all guaranteed DynamicResource-safe
             the same way across versions). -->
        <Setter Property="Background" Value="DodgerBlue"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Every filter row is a WrapPanel rather than a horizontal
         StackPanel, so a narrow Events or Hints/Items column (see the
         draggable GridSplitter) wraps onto another line instead of
         overflowing sideways past its column - StackPanel content isn't
         clipped by its cell, so it used to visually bleed into/over the
         neighboring column instead. WrapPanel has no Spacing property of
         its own, so the per-item gap is a right/bottom Margin on each item
         instead (6px since Kompakteres-Layout.md Teil A, was 8). -->
    <Style Selector="Button.filter-toggle">
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <Style Selector="WrapPanel.filter-row > ComboBox">
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>
    <!-- Draggable divider between the Events column and the Hints/Items
         column (GroupDetailView, DashboardView). Deliberately set only
         here, never locally on the GridSplitter itself - a local value
         would silently beat this style (see CLAUDE.md's style-precedence
         gotcha). Its width comes from the Grid column it sits in (12px in
         both views); keep that column and this splitter in sync. Color is
         a per-theme resource (PanelDividerBrush, App.axaml) so the two
         panels read as clearly separate boxes in both themes. -->
    <Style Selector="GridSplitter.panel-divider">
        <Setter Property="Background" Value="{DynamicResource PanelDividerBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ResizeDirection" Value="Columns"/>
    </Style>

    <!-- Group separator inside a filter row. -->
    <Style Selector="WrapPanel.filter-row > Border.filter-separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>

    <!-- CollapsibleFilterBar (Kompakteres-Layout.md Teil D): the chevron and
         the collapsed summary are flat, borderless buttons - they sit in a
         row of real filter buttons and shouldn't compete with them. Same
         bottom spacing as a filter-toggle button. -->
    <Style Selector="Button.filter-chevron">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Button.filter-summary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <!-- Something is filtered: same accent as an active filter-toggle
         button, so a collapsed bar still signals "not everything shown". -->
    <Style Selector="views|CollapsibleFilterBar:filtering /template/ Button#PART_SummaryButton">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="DodgerBlue"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
</Styles>
