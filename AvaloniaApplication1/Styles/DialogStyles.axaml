<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Opted into via Classes rather than a bare ScrollViewer selector, which
         would also reach into every ListBox's internal template. -->

    <!-- Keeps the scrollbar from overlapping a row's right-aligned button/icon
         once the list scrolls. -->
    <Style Selector="ScrollViewer.dialog-list">
        <Setter Property="Padding" Value="0,0,20,0"/>
    </Style>
</Styles>
