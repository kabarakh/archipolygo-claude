<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App-wide because GroupDetailView is also hosted by DetachedGroupWindow. A Button marks
         PointerPressed handled, so clicking one inside a Dashboard row doesn't also select the row. -->
    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Translucent DodgerBlue accent: a dark tint was barely visible on the light theme. -->
    <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4D1E90FF"/>
    </Style>
    <Style Selector="Button.icon-button:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
</Styles>
