<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>Archipolygo</AssemblyName>
        <RootNamespace>Archipolygo</RootNamespace>
        <AssemblyTitle>Archipolygo</AssemblyTitle>
        <Product>Archipolygo</Product>
        <ApplicationIcon>Assets\archipolyo-icon.ico</ApplicationIcon>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <Optimize>true</Optimize>

        <!-- Read at runtime via AssemblyInformationalVersionAttribute (see
             Services/AppVersionInfo.cs) to show the app's version in the UI.
             "dev" is what every local `dotnet build`/`dotnet run` sees;
             release.yml overrides this on the `dotnet publish` command line
             with the actual release tag, so only that build ever shows a
             real version number. Deliberately InformationalVersion, not
             Version/AssemblyVersion - those must be valid numeric versions,
             which "dev" isn't. -->
        <InformationalVersion>dev</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <Folder Include="Services\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <!-- Lets AvaloniaApplication1.Tests call the small handful of internal
         session-less helper methods (ConnectionManager.FilterToRealPlayers,
         IsTransientConnectFailure, ...) directly instead of duplicating their
         logic or reaching for reflection - see Test-Umsetzungsplan.md,
         Kategorie A. Test-only access, no runtime behavior change. -->
    <ItemGroup>
        <InternalsVisibleTo Include="AvaloniaApplication1.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1"/>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageReference Include="Velopack" Version="1.2.0"/>
    </ItemGroup>
</Project>
