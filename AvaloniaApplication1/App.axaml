<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Archipolygo.App"
             xmlns:local="using:Archipolygo"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared Events-list rendering pieces (per-segment colored
                     TextBlock + its converter) - see the file's own header
                     comment for which views reuse this instead of each
                     re-implementing it. -->
                <ResourceInclude Source="avares://Archipolygo/Views/SharedTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Standardized dialog-level tweaks (e.g. scrollbar/button spacing)
             live here so they're made once and apply to every dialog that
             opts in - see the file's own header comment. -->
        <StyleInclude Source="avares://Archipolygo/Styles/DialogStyles.axaml"/>
    </Application.Styles>
</Application>