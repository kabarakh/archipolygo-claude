<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Archipolygo.App"
             xmlns:local="using:Archipolygo"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared Events-list rendering pieces (per-segment colored
                     TextBlock + its converter) - see the file's own header
                     comment for which views reuse this instead of each
                     re-implementing it. -->
                <ResourceInclude Source="avares://Archipolygo/Views/SharedTemplates.axaml"/>
                <!-- CollapsibleFilterBar's ControlTheme (Kompakteres-Layout.md Teil D). -->
                <ResourceInclude Source="avares://Archipolygo/Views/CollapsibleFilterBar.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Events | Hints/Items divider (GridSplitter.panel-divider in
                 FilterStyles.axaml). Solid per-theme colors rather than one
                 semi-transparent gray: raising a gray overlay's opacity
                 makes it *lighter* on the dark theme's near-black
                 background, not darker. Dark: near-black, darker than the
                 panels. Light: near-white, a step brighter than the
                 panels' own #F3F3F3-ish background but not pure white. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelDividerBrush" Color="#FAFAFA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanelDividerBrush" Color="#0A0A0A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Standardized dialog-level tweaks (e.g. scrollbar/button spacing)
             live here so they're made once and apply to every dialog that
             opts in - see the file's own header comment. -->
        <StyleInclude Source="avares://Archipolygo/Styles/DialogStyles.axaml"/>
        <!-- Filter-row buttons (Button.filter-toggle/.active) - see the file's
             own header comment for why these are app-wide. -->
        <StyleInclude Source="avares://Archipolygo/Styles/FilterStyles.axaml"/>
        <!-- Required for the ColorPicker control used by the Connection
             Editor's server color picker - without this, ColorPicker/
             ColorView render completely unstyled (see the
             Avalonia.Controls.ColorPicker package reference in the .csproj). -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    </Application.Styles>
</Application>