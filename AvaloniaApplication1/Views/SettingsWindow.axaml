<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Archipolygo.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Settings">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <!-- Buttons docked below a scrolling body so Save is never cut off when DialogScreenFit caps the
         height on a short screen. Side margin sits inside the ScrollViewer so its scrollbar uses it. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16" Spacing="8">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="Red"
                       IsVisible="{Binding ValidationError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClick"/>
                <Button Content="Save" Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Margin="16,16,16,0" Spacing="8">
                <CheckBox Content="Auto-connect new profiles by default" IsChecked="{Binding DefaultAutoConnect}"/>

                <CheckBox Content="Compact layout (denser lists and controls)" IsChecked="{Binding CompactDensity}"/>

                <TextBlock Text="Event history limit per tab"/>
                <NumericUpDown Value="{Binding EventHistoryLimit}" Minimum="1" Maximum="100000" FormatString="0"/>

                <Border Height="1" Background="Gray" Opacity="0.3" Margin="0,8,0,0"/>
                <TextBlock Text="Notifications" FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Taskbar blink" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding BlinkModes}" SelectedItem="{Binding SelectedBlinkMode}"/>
                    <!-- Windows only - see SettingsViewModel.SupportsBlinkCount. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Times" VerticalAlignment="Center"
                               IsVisible="{Binding ShowBlinkCount}"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" FormatString="0"
                                   Value="{Binding BlinkCount}" IsVisible="{Binding ShowBlinkCount}"/>
                </Grid>

                <Grid ColumnDefinitions="*,56,56" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="Event" Opacity="0.6" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="Count" Opacity="0.6" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Blink" Opacity="0.6" FontSize="12" HorizontalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding AttentionCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttentionCategoryRowViewModel">
                            <Grid ColumnDefinitions="*,56,56">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Count}" HorizontalAlignment="Center"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding Blink}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Count: shown on the tab, the Dashboard and in the window title. Blink: flash the taskbar button while the window isn't focused. Individual servers can be muted in Edit server."
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                <CheckBox Content="Show unread count in window title" IsChecked="{Binding ShowUnreadInTitle}"/>
                <!-- Hidden where no native badge exists (Linux). -->
                <CheckBox Content="Show unread count as taskbar/Dock badge" IsChecked="{Binding ShowUnreadBadge}"
                          IsVisible="{Binding SupportsUnreadBadge}"/>

                <StackPanel Name="DataSection" Spacing="8" IsVisible="{Binding ShowDataSection}">
                    <Border Height="1" Background="Gray" Opacity="0.3" Margin="0,8,0,0"/>
                    <TextBlock Text="Servers and data" FontWeight="SemiBold"/>

                    <StackPanel Name="ServerTransferButtons" Orientation="Horizontal" Spacing="8">
                        <Button Name="ImportServersButton" Content="Import servers..." Click="OnImportServersClick"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Data folder" Opacity="0.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="OpenDataFolderButton" Content="Open data folder"
                                Click="OnOpenDataFolderClick"/>
                    </Grid>

                    <SelectableTextBlock Name="PortableModeLine"
                                         Text="{Binding DataFolderPath, StringFormat='Portable mode: data stored in {0}'}"
                                         IsVisible="{Binding ShowPortableModeLine}"
                                         Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Name="PortableMarkerIgnoredHint" Text="{Binding PortableMarkerIgnoredText}"
                               IsVisible="{Binding PortableMarkerIgnoredText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DataStatusText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding DataStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Hidden on a manually unzipped install: a check there always finds nothing, which
                     would misleadingly read as "up to date" rather than "can't check". -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding !ShowUnmanagedInstallHint}">
                    <TextBlock Grid.Column="0" Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               Opacity="0.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !IsCheckingForUpdates}"/>
                </Grid>
                <TextBlock Text="{Binding UpdateCheckStatusText}" Opacity="0.7" FontSize="12"
                           IsVisible="{Binding UpdateCheckStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

                <StackPanel Spacing="2" IsVisible="{Binding ShowUnmanagedInstallHint}">
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               Opacity="0.5"/>
                    <TextBlock Text="This is a manually downloaded build, so it can't check for updates on its own. Grab the installer from the latest release on GitHub instead to enable automatic updates."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="Diagnostic log" Opacity="0.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Export..." Click="OnExportDiagnosticLogClick"/>
                </Grid>
                <TextBlock Text="{Binding ExportStatusText}" Opacity="0.7" FontSize="12"
                           IsVisible="{Binding ExportStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
