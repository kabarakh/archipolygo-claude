<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Archipolygo.ViewModels"
             xmlns:m="using:Archipolygo.Models"
             xmlns:views="using:Archipolygo.Views"
             xmlns:conv="using:Archipolygo.Converters"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Archipolygo.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <!-- Own converter instances so the view doesn't depend on its host Window's resources. -->
    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:SlotFilterDisplayConverter x:Key="SlotFilterDisplayConverter"/>
        <conv:DashboardServerFilterDisplayConverter x:Key="DashboardServerFilterDisplayConverter"/>
        <conv:CountToStarWidthConverter x:Key="CountToStarWidthConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Hover cue only for the click-to-navigate lists; on the multi-select Events list
             it fought the real selection highlight. -->
        <Style Selector="ListBox#OverviewListBox ListBoxItem:pointerover /template/ ContentPresenter,
                         ListBox#DashboardHintsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14000000"/>
        </Style>

        <!-- Stretch lets the progress bar use the row's full width. Padding 0 so the row Border's
             edge, where the insertion-line indicator sits, is the true row boundary. -->
        <Style Selector="ListBox#OverviewListBox ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Every visual property, Background included, stays in the style: a local value
             would beat the :pointerover Setter. -->
        <Style Selector="Border.drag-handle">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.drag-handle:pointerover">
            <Setter Property="Background" Value="#4D1E90FF"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding SummaryText}" Opacity="0.7" Margin="0,0,0,6"/>

        <Grid Grid.Row="1" ColumnDefinitions="2*,12,1*">

            <!-- Button+IsVisible toggle, not a nested TabControl, to avoid lazy ContentTemplate materialization. -->
            <Grid Grid.Column="0" MinWidth="220" RowDefinitions="Auto,*">
                <!-- The Overview/Events switch sits outside the collapsible bar: it's navigation, not a filter. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <WrapPanel Grid.Column="0" Classes="filter-row" VerticalAlignment="Top">
                        <Button Content="Overview" Classes="filter-toggle" Command="{Binding ShowOverviewPanelCommand}"
                                Classes.active="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Overview}"/>
                        <Button Content="Events" Classes="filter-toggle" Command="{Binding ShowEventsPanelCommand}"
                                Classes.active="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Events}"/>
                        <Border Classes="filter-separator" IsVisible="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Events}"/>
                    </WrapPanel>
                    <views:CollapsibleFilterBar Grid.Column="1" IsVisible="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Events}"
                                                IsExpanded="{Binding FilterLayout.DashboardEventsFiltersExpanded}"
                                                Summary="{Binding EventFilterSummaryText}">
                        <WrapPanel Classes="filter-row">
                            <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllEventsRelevanceCommand}"
                                    Classes.active="{Binding SelectedEventRelevanceFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                            <Button Content="Concerns me" Classes="filter-toggle" Command="{Binding ShowOwnEventsOnlyCommand}"
                                    Classes.active="{Binding SelectedEventRelevanceFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConcernsMe}"/>
                            <Border Classes="filter-separator"/>
                            <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllEventCategoriesCommand}"
                                    Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                            <Button Content="Hints" Classes="filter-toggle" Command="{Binding ShowHintEventsOnlyCommand}"
                                    Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"/>
                            <Button Content="Items" Classes="filter-toggle" Command="{Binding ShowItemEventsOnlyCommand}"
                                    Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Items}"/>
                            <Button Content="Chat" Classes="filter-toggle" Command="{Binding ShowChatEventsOnlyCommand}"
                                    Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Chat}"/>
                            <Button Content="Admin" Classes="filter-toggle" Command="{Binding ShowAdminEventsOnlyCommand}" IsVisible="{Binding HasAdminServer}"
                                    Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Admin}"/>
                            <Border Classes="filter-separator"/>
                            <views:ItemClassFilterButton/>
                            <ComboBox Name="DashboardEventsServerComboBox" Width="130"
                                      ItemsSource="{Binding EventsFilter.ServerOptions}" SelectedItem="{Binding EventsFilter.SelectedServer}">
                                <ComboBox.ItemTemplate>
                                    <!-- Deliberately untyped - see the identical Hints server dropdown's comment. -->
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DashboardServerFilterDisplayConverter}}"
                                                   MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Name="DashboardEventsSlotComboBox" Width="130"
                                      ItemsSource="{Binding EventsFilter.SlotOptions}" SelectedItem="{Binding EventsFilter.SelectedSlot}"
                                      IsEnabled="{Binding EventsFilter.SelectedServer, Converter={x:Static avconv:ObjectConverters.IsNotNull}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SlotFilterDisplayConverter}}"
                                                   MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </WrapPanel>
                    </views:CollapsibleFilterBar>
                </Grid>

                <!-- OnOverviewRowSelected clears the selection again so the same row can be clicked twice.
                     Drags only start from the grip handle, so a plain click never has to disambiguate. -->
                <ListBox Name="OverviewListBox" Grid.Row="1" ItemsSource="{Binding Groups}"
                         IsVisible="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Overview}"
                         SelectionChanged="OnOverviewRowSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:GroupViewModel">
                            <!-- Background="Transparent" makes the whole row hit-testable, so DragOver/Drop in gaps between
                                 children still reach the handlers. Tag lets tests find the row among other Borders. -->
                            <Border Background="Transparent"
                                    Tag="OverviewRow"
                                    DragDrop.AllowDrop="True"
                                    PointerPressed="OnOverviewRowPointerPressed"
                                    DragDrop.DragOver="OnOverviewRowDragOver"
                                    DragDrop.DragLeave="OnOverviewRowDragLeave"
                                    DragDrop.Drop="OnOverviewRowDrop">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in new window" Click="OnOpenInNewWindowMenuClick" IsEnabled="{Binding !IsDetached}"/>
                                    <MenuItem Header="{Binding MuteMenuHeader}" Click="OnToggleMuteMenuClick"/>
                                    <MenuItem Header="Copy host:port" Click="OnCopyHostPortMenuClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <!-- Grid so the insertion-line Rectangles layer on top of the row content. -->
                            <Grid>
                            <!-- Margin on the content, not Border Padding, so the Rectangles sit on the true row edge.
                                 Asymmetric 8,11,8,14 was measured to keep the original 63px row height. -->
                            <StackPanel Spacing="4" Margin="8,11,8,14">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Plain Border, not a Button: a Button's own click tracking would fight the drag-threshold
                                         detection in OnOverviewGripPointerPressed/Moved. -->
                                    <Border Grid.Column="0" Classes="drag-handle" Cursor="Hand" Margin="0,0,8,0"
                                            PointerPressed="OnOverviewGripPointerPressed"
                                            PointerMoved="OnOverviewGripPointerMoved"
                                            PointerReleased="OnOverviewGripPointerReleased">
                                        <ToolTip.Tip><TextBlock Text="Drag to reorder"/></ToolTip.Tip>
                                        <Path Data="M3,3 L3,3 M9,3 L9,3 M3,8 L3,8 M9,8 L9,8 M3,13 L3,13 M9,13 L9,13"
                                              Stroke="#5f5e5a" StrokeThickness="2.5" StrokeLineCap="Round"
                                              Width="12" Height="16" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding ColorBrush}"/>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding ColorBrush}"/>
                                        <Path Data="{StaticResource BellOffGeometry}" Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{Binding $parent[ListBoxItem].Foreground}" StrokeThickness="1.4" Opacity="0.6"
                                              VerticalAlignment="Center" IsVisible="{Binding IsNotificationsMuted}"
                                              ToolTip.Tip="Notifications muted for this server"/>
                                        <Border Background="#e6f1fb" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UnreadAttentionCount, StringFormat='{}{0} events'}" FontSize="11" Foreground="#0c447c"/>
                                        </Border>
                                        <Border Background="#faeeda" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UnfoundHintCount, StringFormat='{}{0} hints'}" FontSize="11" Foreground="#854f0b"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Add slot/Edit server/Remove server raise DashboardView events: their dialogs need a Window
                                         and MainWindowViewModel, which this row's DataContext lacks. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <!-- Tag, not x:Name: a repeated x:Name inside an ItemTemplate collides once several rows exist. -->
                                        <Button Classes="icon-button" Tag="Connect" IsVisible="{Binding CanConnect}" Command="{Binding ConnectCommand}">
                                            <ToolTip.Tip><TextBlock Text="Connect"/></ToolTip.Tip>
                                            <Path Data="M4,3 L13,8 L4,13 Z" Fill="#3b6d11" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button Classes="icon-button" Tag="Disconnect" IsVisible="{Binding !CanConnect}" Command="{Binding DisconnectCommand}">
                                            <ToolTip.Tip><TextBlock Text="Disconnect"/></ToolTip.Tip>
                                            <Path Data="M4,4 L12,4 L12,12 L4,12 Z" Fill="#5f5e5a" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button Classes="icon-button" Tag="AddSlot" IsEnabled="{Binding IsLeaderConnected}" Click="OnAddSlotIconClick">
                                            <ToolTip.Tip><TextBlock Text="Add slot"/></ToolTip.Tip>
                                            <Path Data="M8,3 L8,13 M3,8 L13,8" Stroke="#5f5e5a" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button Classes="icon-button" Tag="EditServer" Click="OnEditServerIconClick">
                                            <ToolTip.Tip><TextBlock Text="Edit server"/></ToolTip.Tip>
                                            <Path Data="M2,14 L2,11 L9,4 L12,7 L5,14 Z M10,3 L13,6 L14,5 L11,2 Z" Fill="#5f5e5a" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button Classes="icon-button" Tag="RemoveServer" Click="OnRemoveServerIconClick">
                                            <ToolTip.Tip><TextBlock Text="Remove server"/></ToolTip.Tip>
                                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#a32d2d" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Same bar as the tab's own in MainWindow.axaml, deliberately duplicated rather than shared. -->
                                <!-- Grid, not StackPanel: a StackPanel gives Star-weighted columns no width, collapsing the bar. -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,0,0,0"
                                      IsVisible="{Binding HasAnyProgress}">
                                    <Grid Grid.Column="0" Height="8" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding OwnChecksDone, Converter={StaticResource CountToStarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding OwnChecksOpen, Converter={StaticResource CountToStarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding OtherChecksDone, Converter={StaticResource CountToStarWidthConverter}}"/>
                                            <ColumnDefinition Width="{Binding OtherChecksOpen, Converter={StaticResource CountToStarWidthConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#2F9E44"/>
                                        <Border Grid.Column="1" Background="#4B5A4B"/>
                                        <Border Grid.Column="2" Background="#1971C2"/>
                                        <Border Grid.Column="3" Background="#3D4A5C"/>

                                        <ToolTip.Tip>
                                            <StackPanel Spacing="4" MaxWidth="240">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="10" Height="10" Background="#2F9E44" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OwnChecksDoneLegendText}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="10" Height="10" Background="#4B5A4B" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OwnChecksOpenLegendText}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasMultiworldTracker}">
                                                    <Border Width="10" Height="10" Background="#1971C2" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OtherChecksDoneLegendText}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasMultiworldTracker}">
                                                    <Border Width="10" Height="10" Background="#3D4A5C" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OtherChecksOpenLegendText}"/>
                                                </StackPanel>
                                                <TextBlock Text="Add a multiworld tracker in Edit Server to also see everyone else's progress in this room."
                                                           TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic"
                                                           IsVisible="{Binding !HasMultiworldTracker}"/>
                                            </StackPanel>
                                        </ToolTip.Tip>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding RoomProgressPercent, StringFormat='{}{0:0}%'}"
                                               FontSize="11" Opacity="0.7" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding ConnectionState, StringFormat='{}{0} - no progress data yet'}"
                                           Opacity="0.6" FontStyle="Italic" FontSize="11" Margin="16,0,0,0"
                                           IsVisible="{Binding !HasAnyProgress}"/>
                            </StackPanel>

                            <Rectangle Height="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Fill="DodgerBlue"
                                       IsVisible="{Binding DropIndicator, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Before}"/>
                            <Rectangle Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Fill="DodgerBlue"
                                       IsVisible="{Binding DropIndicator, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=After}"/>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Display filter up top and the "who's chatting" pair below are deliberately decoupled. -->
                <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto"
                      IsVisible="{Binding SelectedLeftPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Events}">
                    <Grid Grid.Row="0">
                        <!-- Multi-select log like a server tab's Events list, not a click-to-navigate list. -->
                        <ListBox Name="DashboardEventsListBox" ItemsSource="{Binding VisibleEvents}"
                                 SelectionMode="Multiple" KeyDown="OnDashboardEventsListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="m:DashboardEventRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                        <TextBlock Text="{Binding Group.HeaderText}" Foreground="{Binding Group.ColorBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Event.Timestamp, StringFormat='HH:mm:ss'}" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding Event.EffectiveSegments}"
                                                      ItemTemplate="{StaticResource EventTextSegmentTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <views:JumpToNewestButton TargetListBox="{Binding #DashboardEventsListBox}"/>
                    </Grid>

                    <!-- Picking the slot here is the real leader switch: binds to the group's own live state. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="Send as:" Opacity="0.7" VerticalAlignment="Center"/>
                        <ComboBox Name="DashboardSendServerComboBox" Width="130"
                                  ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedSendServerGroup}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:GroupViewModel">
                                    <TextBlock Text="{Binding HeaderText}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Name="DashboardSendSlotComboBox" Width="130"
                                  ItemsSource="{Binding SelectedSendServerGroup.Slots}"
                                  SelectedItem="{Binding SelectedSendServerGroup.SelectedChatSlot}"
                                  IsEnabled="{Binding SelectedSendServerGroup, Converter={x:Static avconv:ObjectConverters.IsNotNull}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="m:SlotProfile">
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Binds CanSendMessage, not a nested SelectedSendServerGroup.IsLeaderConnected path, which
                         doesn't reliably gray out with nothing selected. -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBox Grid.Column="0" Text="{Binding SelectedSendServerGroup.MessageToSend}" PlaceholderText="Message..."
                                 IsEnabled="{Binding CanSendMessage}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SelectedSendServerGroup.SendMessageCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Send" Command="{Binding SelectedSendServerGroup.SendMessageCommand}"
                                IsEnabled="{Binding CanSendMessage}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="panel-divider"/>

            <Grid Grid.Column="2" MinWidth="150" RowDefinitions="Auto,*">
                <!-- "Unfound only" note lives in the bar's tooltip, not the list's, so it doesn't pop up
                     over the click-to-navigate hint rows. -->
                <views:CollapsibleFilterBar Grid.Row="0" ToolTip.Tip="Showing unfound hints only, across all servers"
                                            IsExpanded="{Binding FilterLayout.DashboardHintsFiltersExpanded}"
                                            Summary="{Binding HintFilterSummaryText}">
                    <WrapPanel Classes="filter-row">
                        <ComboBox Width="130"
                                  ItemsSource="{Binding HintFilter.ServerOptions}" SelectedItem="{Binding HintFilter.SelectedServer}">
                            <ComboBox.ItemTemplate>
                                <!-- Deliberately untyped (no x:DataType): the leading entry is a null "All servers"
                                     placeholder a compiled GroupViewModel binding wouldn't match. -->
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DashboardServerFilterDisplayConverter}}"
                                               MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="130"
                                  ItemsSource="{Binding HintFilter.SlotOptions}" SelectedItem="{Binding HintFilter.SelectedSlot}"
                                  IsEnabled="{Binding HintFilter.SelectedServer, Converter={x:Static avconv:ObjectConverters.IsNotNull}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SlotFilterDisplayConverter}}"
                                               MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Classes="filter-separator"/>
                        <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllHintItemCategoriesCommand}"
                                Classes.active="{Binding SelectedHintItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                        <Button Content="Progression" Classes="filter-toggle" Command="{Binding ShowProgressHintItemsCommand}"
                                Classes.active="{Binding SelectedHintItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Progress}"/>
                        <Button Content="Useful" Classes="filter-toggle" Command="{Binding ShowUsefulHintItemsCommand}"
                                Classes.active="{Binding SelectedHintItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Useful}"/>
                        <Button Content="Normal" Classes="filter-toggle" Command="{Binding ShowNormalHintItemsCommand}"
                                Classes.active="{Binding SelectedHintItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Normal}"/>
                        <Button Content="Trap" Classes="filter-toggle" Command="{Binding ShowTrapHintItemsCommand}"
                                Classes.active="{Binding SelectedHintItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Trap}"/>
                    </WrapPanel>
                </views:CollapsibleFilterBar>

                <ListBox Name="DashboardHintsListBox" Grid.Row="1" ItemsSource="{Binding VisibleHints}"
                         SelectionChanged="OnHintRowSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="m:DashboardHintRow">
                            <StackPanel Spacing="2" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Group.HeaderText}" Foreground="{Binding Group.ColorBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="·" Opacity="0.5"/>
                                    <TextBlock Text="{Binding Hint.ItemName}" FontWeight="Bold" TextWrapping="Wrap"
                                               Foreground="{Binding Hint.ItemKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                    <TextBlock Text="-" Opacity="0.5"/>
                                    <TextBlock Text="{Binding Hint.ReceivingPlayerName}" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Hint.FindingPlayerName}" Opacity="0.85" TextWrapping="Wrap"/>
                                    <TextBlock Text=":" Opacity="0.7"/>
                                    <TextBlock Text="{Binding Hint.LocationName}" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
