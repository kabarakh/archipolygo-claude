<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        x:Class="Archipolygo.Views.AdminPlayerWindow"
        x:DataType="vm:AdminPlayerDialogViewModel"
        Width="460" Height="600"
        MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        CanResize="True">

    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="{Binding Player.DisplayName}" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="{Binding SubHeader}" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
            <RadioButton GroupName="AdminMode" Content="Send item" IsChecked="{Binding IsItemMode}"/>
            <RadioButton GroupName="AdminMode" Content="Send location" IsChecked="{Binding IsLocationMode}"/>
        </StackPanel>

        <!-- The server caps /send_multiple at 100. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsItemMode}">
            <TextBlock Text="Amount:" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding Amount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="130"/>
        </StackPanel>

        <!-- The tracker's player_checks_done is the only source of checked
             locations for another player. -->
        <CheckBox DockPanel.Dock="Top" Content="Hide already checked locations" IsChecked="{Binding HideChecked}"
                  IsVisible="{Binding ShowHideCheckedCheckbox}" Margin="0,10,0,0"/>
        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding ShowNoTrackerNote}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="No tracker data - already checked locations can't be hidden."/>

        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search..." Margin="0,10,0,0"/>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Release..." Command="{Binding ReleaseCommand}"/>
                <Button Content="Collect..." Command="{Binding CollectCommand}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Close" Click="OnCloseClick"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasResult}" Background="#22888888" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <Grid Margin="0,10,0,0">
            <ScrollViewer Classes="dialog-list" IsVisible="{Binding !IsLoading}">
                <ItemsControl ItemsSource="{Binding FilteredRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- Reflection binding so the command resolves off the Window's view model. -->
                        <DataTemplate x:CompileBindings="False">
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.SendRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,2,6,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Loading names..." Opacity="0.6" IsVisible="{Binding IsLoading}"/>
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="Nothing matches." Opacity="0.6" IsVisible="{Binding HasNoMatches}"/>
        </Grid>
    </DockPanel>
</Window>
