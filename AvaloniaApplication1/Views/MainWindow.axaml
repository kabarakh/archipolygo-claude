<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:m="using:Archipolygo.Models"
        xmlns:views="using:Archipolygo.Views"
        xmlns:conv="using:Archipolygo.Converters"
        xmlns:avconv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Archipolygo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/archipolyo-icon.ico"
        Title="{Binding MainWindowTitle}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabItem:selected">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Zeroed (themed as TabItemHeaderMargin) so the header Border's bounds
             equal the tab's and the insertion lines sit exactly between two tabs. -->
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="0"/>
        </Style>

    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Grid so the theme button sits at the window's right edge, not just right
             of the last toolbar button. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/project-logo.png" Width="28" Height="28" VerticalAlignment="Center"/>
            <Button Content="{Binding DashboardToggleButtonText}" Command="{Binding ToggleDashboardCommand}"/>
            <Border Width="1" Background="Gray" Opacity="0.5" VerticalAlignment="Stretch" Margin="0,2"/>
            <!-- Hidden on the Dashboard: these act on SelectedGroup, and there's no
                 single current server there. -->
            <Button Content="Add server..." Click="OnAddServerClick"/>
            <Button Content="Add slot..." Click="OnAddSlotClick" IsVisible="{Binding !IsDashboardVisible}"/>
            <Button Content="Edit server..." Click="OnEditServerClick" IsVisible="{Binding !IsDashboardVisible}"/>
            <Button Content="Remove server" Command="{Binding RemoveSelectedGroupCommand}" IsVisible="{Binding !IsDashboardVisible}"/>
            <Button Content="Disconnect all" Command="{Binding DisconnectAllGroupsCommand}"/>
            <Button Content="Settings..." Click="OnSettingsClick"/>
            <Button Name="UpdateAvailableButton" Content="Update available" Background="OrangeRed" Foreground="White"
                    IsVisible="{Binding IsUpdateAvailable}" Click="OnUpdateBadgeClick">
                <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="8" Width="220">
                            <TextBlock Text="{Binding NewUpdateVersion, StringFormat='Version {0} is available.'}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Update now" Command="{Binding UpdateNowCommand}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </StackPanel>

        <Button Grid.Column="1" Content="{Binding ThemeButtonGlyph}"
                ToolTip.Tip="{Binding ThemeButtonTooltip}"
                Command="{Binding CycleThemeCommand}"
                FontSize="16" Margin="8" VerticalAlignment="Center"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="#332196F3" Padding="8,4"
                IsVisible="{Binding IsStartupSyncing}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StartupSyncStatusText}" FontSize="12"/>
                <ProgressBar Minimum="0" Maximum="{Binding StartupSyncTotal}" Value="{Binding StartupSyncCompleted}"
                             Height="4" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- A view swap rather than a real TabItem, so Groups never needs a
             mixed-type collection. -->
        <Grid>
        <TabControl IsVisible="{Binding !IsDashboardVisible}" ItemsSource="{Binding DockedGroups}" SelectedItem="{Binding SelectedGroup}">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:GroupViewModel">
                    <!-- Nothing here marks PointerPressed Handled, so a plain click still selects
                         the tab; only a move past the threshold starts a drag. -->
                    <!-- Transparent, not unset: a Border without a Background isn't hit-test
                         visible across its empty area. -->
                    <!-- Tag, not Name: a repeated x:Name in a DataTemplate collides once several
                         tabs are realized. No Padding, see the StackPanel's Margin. -->
                    <Border Background="Transparent"
                            Tag="GroupTabHeader"
                            DragDrop.AllowDrop="True"
                            PointerPressed="OnGroupTabPointerPressed"
                            PointerMoved="OnGroupTabPointerMoved"
                            PointerReleased="OnGroupTabPointerReleased"
                            DragDrop.DragOver="OnGroupTabDragOver"
                            DragDrop.DragLeave="OnGroupTabDragLeave"
                            DragDrop.Drop="OnGroupTabDrop">
                        <!-- A context menu rather than a drag gesture: dragging a tab out into a new
                             native window proved unreliable. -->
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in new window" Click="OnDetachTabMenuClick"/>
                                <MenuItem Header="{Binding MuteMenuHeader}" Click="OnToggleMuteMenuClick"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <!-- Margin here, not Padding on the Border: Padding would also inset the
                                 insertion-line Rectangles away from the true tab boundary. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding ColorBrush}"/>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                                <Border Background="OrangeRed" CornerRadius="8" MinWidth="16" Height="16"
                                        Padding="4,0" VerticalAlignment="Center"
                                        IsVisible="{Binding HasUnreadAttention}">
                                    <TextBlock Text="{Binding UnreadAttentionCount}" Foreground="White" FontSize="10"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding HeaderText}" Foreground="{Binding ColorBrush}"/>
                                <Path Data="{StaticResource BellOffGeometry}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{Binding $parent[TabItem].Foreground}" StrokeThickness="1.4" Opacity="0.6"
                                      VerticalAlignment="Center" IsVisible="{Binding IsNotificationsMuted}"
                                      ToolTip.Tip="Notifications muted for this server"/>
                                <TextBlock Text="{Binding ConnectionState}" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" IsVisible="{Binding !IsLeaderConnected}"/>
                            </StackPanel>

                            <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="DodgerBlue"
                                       IsVisible="{Binding DropIndicator, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Before}"/>
                            <Rectangle Width="3" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="DodgerBlue"
                                       IsVisible="{Binding DropIndicator, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=After}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:GroupViewModel">
                    <views:GroupDetailView/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- IsVisible on this wrapper: DashboardView's DataContext is Dashboard,
             which has no IsDashboardVisible. -->
        <!-- Same inset as the TabControl's content, so toggling the Dashboard
             doesn't shift the panels. -->
        <Border IsVisible="{Binding IsDashboardVisible}" Padding="{DynamicResource TabItemMargin}">
            <views:DashboardView x:Name="DashboardViewControl" DataContext="{Binding Dashboard}"/>
        </Border>
        </Grid>
    </DockPanel>

</Window>
