<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:m="using:Archipolygo.Models"
        xmlns:conv="using:Archipolygo.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Archipolygo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/archipolyo-icon.ico"
        Title="Archipolygo">

    <Window.Resources>
        <conv:EventTextSegmentKindToBrushConverter x:Key="SegmentKindToBrushConverter"/>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter"/>
        <conv:SlotFilterDisplayConverter x:Key="SlotFilterDisplayConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Makes the currently active tab's header text stand out, beyond
             just the Fluent theme's default selection underline. -->
        <Style Selector="TabItem:selected">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- The log filter buttons (Events relevance/category, Hints) each
             get an "active" class bound to whether they represent the
             currently selected filter value (see Classes.active on each
             Button below); this highlights the active one so it's
             unmistakable at a glance, independently of which Command
             actually changed the filter. -->
        <Style Selector="Button.filter-toggle.active">
            <!-- A plain named brush rather than a theme accent resource, to
                 avoid relying on exactly which accent-related resource key
                 the installed Fluent theme version exposes (some are Color,
                 not IBrush, and aren't all guaranteed DynamicResource-safe
                 the same way across versions). -->
            <Setter Property="Background" Value="DodgerBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/project-logo.png" Width="28" Height="28" VerticalAlignment="Center"/>
            <Button Content="Add server..." Click="OnAddServerClick"/>
            <Button Content="Add slot..." Click="OnAddSlotClick"/>
            <Button Content="Edit server..." Click="OnEditServerClick"/>
            <Button Content="Remove server" Command="{Binding RemoveSelectedGroupCommand}"/>
            <Button Content="Disconnect all" Command="{Binding DisconnectAllGroupsCommand}"/>
            <Button Content="Settings..." Click="OnSettingsClick"/>
        </StackPanel>

        <!-- Startup-only progress indicator - visible while
             MainWindowViewModel.InitializeGroupsAsync is still working
             through every configured slot's initial catch-up sync (leader
             connects and non-leader catch-up dips alike); disappears again
             once that one-time startup pass finishes. The bar itself is
             purely cosmetic (Value/Maximum mirror the same two counts as
             the text underneath) - it's there so progress reads as a
             visibly filling bar rather than just a changing number. -->
        <Border DockPanel.Dock="Top" Background="#332196F3" Padding="8,4"
                IsVisible="{Binding IsStartupSyncing}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StartupSyncStatusText}" FontSize="12"/>
                <ProgressBar Minimum="0" Maximum="{Binding StartupSyncTotal}" Value="{Binding StartupSyncCompleted}"
                             Height="4" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <TabControl ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:GroupViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrushConverter}}"/>
                        <Border Background="OrangeRed" CornerRadius="8" MinWidth="16" Height="16"
                                Padding="4,0" VerticalAlignment="Center"
                                IsVisible="{Binding HasUnreadEvents}">
                            <TextBlock Text="{Binding UnreadEventCount}" Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding HeaderText}"/>
                        <!-- Only shown while there's no live leader connection,
                             so the tab itself surfaces "disconnected"/
                             "connecting"/"reconnecting"/"error" without
                             needing to select it. -->
                        <TextBlock Text="{Binding ConnectionState}" FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" IsVisible="{Binding !IsLeaderConnected}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:GroupViewModel">
                    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
                        <!-- Connection status and the one action that affects it
                             (Disconnect) - the account dropdown that actually
                             switches the live connection lives down by the message
                             box instead, where it's used (see Grid.Row="2" below). -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Explicit VerticalAlignment="Center" on each text
                                 element: without it, a horizontal StackPanel
                                 stretches every child to the row's full height
                                 (set by the tallest child, the Button, whose
                                 padding makes it taller than plain text), and
                                 TextBlock content defaults to top-aligned
                                 within that stretched bounds - which visibly
                                 sits higher than the button's own (centered)
                                 label. -->
                            <TextBlock Text="{Binding Group.HostPort}" VerticalAlignment="Center"/>
                            <TextBlock Text="-" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionState}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- RowDefinitions: header row (Auto) + content row (*).
                             The header row just holds the "Events" label and
                             the Hints/Items panel selector side-by-side; each
                             column's own "Show:" slot-filter dropdown lives
                             one row down instead (see the Grid.Row="1"/"2"
                             skeletons below), so both dropdowns end up on the
                             same row, lined up with each other under the
                             filter-toggle buttons. -->
                        <Grid Grid.Row="1" ColumnDefinitions="2*,8,1*" RowDefinitions="Auto,*">

                            <!-- ── Header row ── -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Events" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="2"
                                        Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <Button Content="{Binding HintsPanelButtonText}" Classes="filter-toggle" Command="{Binding ShowHintsPanelCommand}"
                                        Classes.active="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"/>
                                <Button Content="Items" Classes="filter-toggle" Command="{Binding ShowReceivedItemsPanelCommand}"
                                        Classes.active="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReceivedItems}"/>
                            </StackPanel>

                            <!-- ── Content row: Events ──
                                 Same three-row skeleton as the Hints/Items
                                 column (filter buttons / slot filter / list),
                                 so the "Show:" dropdown lines up on the same
                                 row as the Hints/Items slot filter next to it. -->
                            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllEventsRelevanceCommand}"
                                            Classes.active="{Binding SelectedEventRelevanceFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                                    <Button Content="Concerns me" Classes="filter-toggle" Command="{Binding ShowOwnEventsOnlyCommand}"
                                            Classes.active="{Binding SelectedEventRelevanceFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConcernsMe}"/>
                                    <Border Width="1" Background="Gray" Opacity="0.5" Margin="2,0"/>
                                    <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllEventCategoriesCommand}"
                                            Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                                    <Button Content="Hints" Classes="filter-toggle" Command="{Binding ShowHintEventsOnlyCommand}"
                                            Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"/>
                                    <Button Content="Items" Classes="filter-toggle" Command="{Binding ShowItemEventsOnlyCommand}"
                                            Classes.active="{Binding SelectedEventCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Items}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="Show:" Opacity="0.7" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SlotFilterOptions}" SelectedItem="{Binding SelectedEventsSlotFilter}" MinWidth="110">
                                        <ComboBox.ItemTemplate>
                                            <!-- Deliberately untyped (no x:DataType): this list's
                                                 first entry is a null placeholder for "All slots"
                                                 (see SlotFilterOptions), and a compiled binding
                                                 typed to SlotProfile would not match a null item. -->
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SlotFilterDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- SelectionMode="Multiple" (ctrl/shift-click, like Explorer)
                                     so several lines can be selected and copied at once - see
                                     OnEventsListKeyDown. -->
                                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleEvents}" SelectionMode="Multiple"
                                         KeyDown="OnEventsListKeyDown" Loaded="OnEventsListLoaded">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="m:EventEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Opacity="0.6"/>
                                                <TextBlock Text="NEW" FontWeight="Bold" Foreground="OrangeRed"
                                                           IsVisible="{Binding IsNewSinceLastSession}"/>
                                                <TextBlock Text="{Binding Type}" Opacity="0.6"/>
                                                <ItemsControl ItemsSource="{Binding EffectiveSegments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="m:EventTextSegment">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                       Foreground="{Binding Kind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- ── Content row: Hints / Items panels ──
                                 Three explicit rows so both panels share an
                                 identical layout skeleton and the list always
                                 starts at the same vertical position:
                                   Row 0 (Auto) – panel-specific filter buttons
                                   Row 1 (Auto) – panel-specific slot filter + search box, always rendered
                                   Row 2 (*)    – list
                                 Because row 1 is always in the layout tree it
                                 never changes the row heights when switching
                                 panels. The search box filters by item name in
                                 both modes, so it's shared rather than duplicated
                                 per panel; the slot filter differs per panel
                                 (SelectedHintsSlotFilter/SelectedItemsSlotFilter
                                 are independent - see GroupViewModel), so that
                                 half of the row is the same toggle-by-panel pair
                                 as the filter buttons above it. -->
                            <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">

                                <!-- Row 0 – Hints filters -->
                                <StackPanel Grid.Row="0"
                                            IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"
                                            Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllHintsCommand}"
                                            Classes.active="{Binding SelectedHintFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                                    <Button Content="Unfound" Classes="filter-toggle" Command="{Binding ShowUnfoundHintsCommand}"
                                            Classes.active="{Binding SelectedHintFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Unfound}"/>
                                    <Border Width="1" Background="Gray" Opacity="0.5" Margin="2,0"/>
                                    <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllHintRolesCommand}"
                                            Classes.active="{Binding SelectedHintRoleFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                                    <Button Content="{Binding HintsIFindButtonText}" Classes="filter-toggle" Command="{Binding ShowHintsIFindCommand}"
                                            Classes.active="{Binding SelectedHintRoleFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=IFind}"/>
                                    <Button Content="{Binding HintsIReceiveButtonText}" Classes="filter-toggle" Command="{Binding ShowHintsIReceiveCommand}"
                                            Classes.active="{Binding SelectedHintRoleFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=IReceive}"/>
                                </StackPanel>

                                <!-- Row 0 – Items filters (same row, alternates with hints filters) -->
                                <StackPanel Grid.Row="0"
                                            IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReceivedItems}"
                                            Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <Button Content="All" Classes="filter-toggle" Command="{Binding ShowAllItemCategoriesCommand}"
                                            Classes.active="{Binding SelectedItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All}"/>
                                    <Button Content="Progress" Classes="filter-toggle" Command="{Binding ShowProgressItemsCommand}"
                                            Classes.active="{Binding SelectedItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Progress}"/>
                                    <Button Content="Useful" Classes="filter-toggle" Command="{Binding ShowUsefulItemsCommand}"
                                            Classes.active="{Binding SelectedItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Useful}"/>
                                    <Button Content="Normal" Classes="filter-toggle" Command="{Binding ShowNormalItemsCommand}"
                                            Classes.active="{Binding SelectedItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Normal}"/>
                                    <Button Content="Trap" Classes="filter-toggle" Command="{Binding ShowTrapItemsCommand}"
                                            Classes.active="{Binding SelectedItemCategoryFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Trap}"/>
                                </StackPanel>

                                <!-- Row 1 – slot filter (per-panel) + search box (shared, filters active panel) -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                    <ComboBox Grid.Column="0" MinWidth="110" Margin="0,0,8,0"
                                              IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"
                                              ItemsSource="{Binding SlotFilterOptions}" SelectedItem="{Binding SelectedHintsSlotFilter}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SlotFilterDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="0" MinWidth="110" Margin="0,0,8,0"
                                              IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReceivedItems}"
                                              ItemsSource="{Binding SlotFilterOptions}" SelectedItem="{Binding SelectedItemsSlotFilter}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SlotFilterDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding ItemSearchText}" PlaceholderText="Search..."/>
                                </Grid>

                                <!-- Row 2 – Hints list. SelectionMode="Multiple" + KeyDown, same
                                     copy-selected-lines mechanism as the Events list above (see
                                     OnHintsListKeyDown), just with its own selection/clipboard
                                     since the two lists are otherwise unrelated. -->
                                <ListBox Grid.Row="2"
                                         IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hints}"
                                         ItemsSource="{Binding VisibleHints}" SelectionMode="Multiple"
                                         KeyDown="OnHintsListKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="m:HintEntry">
                                            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="NEW" FontWeight="Bold" Foreground="OrangeRed"
                                                               IsVisible="{Binding IsNewSinceLastSession}"/>
                                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="Green"
                                                               IsVisible="{Binding Found}"/>
                                                    <TextBlock Text="{Binding ItemName}" FontWeight="Bold" TextWrapping="Wrap"
                                                               Foreground="{Binding ItemKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FindingPlayerName}" Opacity="0.85" TextWrapping="Wrap"
                                                               Foreground="{Binding FindingPlayerKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                    <TextBlock Text="-&gt;" Opacity="0.7"/>
                                                    <TextBlock Text="{Binding ReceivingPlayerName}" Opacity="0.85" TextWrapping="Wrap"
                                                               Foreground="{Binding ReceivingPlayerKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                    <TextBlock Text=":" Opacity="0.7"/>
                                                    <TextBlock Text="{Binding LocationName}" Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Row 2 – Items list (same row, alternates with hints list) -->
                                <ListBox Grid.Row="2"
                                         IsVisible="{Binding SelectedRightPanel, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReceivedItems}"
                                         ItemsSource="{Binding VisibleReceivedItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="m:ReceivedItemEntry">
                                            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,2">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="Bold" TextWrapping="Wrap"
                                                           Foreground="{Binding ItemKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding SenderName}" Opacity="0.85" TextWrapping="Wrap"
                                                               Foreground="{Binding SenderKind, Converter={StaticResource SegmentKindToBrushConverter}}"/>
                                                    <TextBlock Text=":" Opacity="0.5"/>
                                                    <TextBlock Text="{Binding LocationName}" Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Grid>
                        </Grid>

                        <!-- Account dropdown lives here, right next to the field it
                             actually enables - the ONE control whose change opens/
                             closes a connection: picking a different slot switches
                             which one is the live "leader" for this server (see
                             GroupViewModel.OnSelectedChatSlotChanged / Umsetzungsplan.md
                             Phase 6). -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                            <!-- Loaded="OnChatSlotComboBoxLoaded": a tab that was never
                                 the active one at startup has its content template (and
                                 with it, this ComboBox) materialized for the very first
                                 time only once the user actually clicks that tab - by
                                 then, SelectedChatSlot on the view model has long since
                                 been set correctly (leader connected at startup), but the
                                 brand-new ComboBox's own initial SelectedItem-vs-ItemsSource
                                 resolution can come up empty and never visibly reflect it,
                                 even though the bound value itself is fine. Forcing one
                                 explicit resync once this instance is actually loaded fixes
                                 the display without touching the underlying value. -->
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedChatSlot}"
                                      MinWidth="140" Margin="0,0,8,0" Loaded="OnChatSlotComboBoxLoaded">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="m:SlotProfile">
                                        <TextBlock Text="{Binding SlotName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding MessageToSend}" PlaceholderText="Message..."
                                     IsEnabled="{Binding IsLeaderConnected}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Send" Command="{Binding SendMessageCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>

</Window>
