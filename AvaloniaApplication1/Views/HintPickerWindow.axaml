<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:m="using:Archipolygo.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Archipolygo.Views.HintPickerWindow"
        x:DataType="vm:HintPickerViewModel"
        Width="460" Height="560"
        MinWidth="380" MinHeight="360"
        Title="Request a Hint"
        CanResize="True">

    <!-- DockPanel so Close stays pinned bottom-right; the undocked last child
         fills the remaining space. -->
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
            <RadioButton GroupName="HintMode" Content="Hint for item" IsChecked="{Binding IsItemMode}"/>
            <RadioButton GroupName="HintMode" Content="Hint for location" IsChecked="{Binding IsLocationMode}"/>
        </StackPanel>

        <!-- Any configured slot, not just the leader: IConnectionManager briefly
             connects as a non-leader slot when needed. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="Slot:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="m:SlotProfile">
                        <!-- Left, not Stretch: in this wide ComboBox a Stretch item capped by
                             MaxWidth gets centered instead of flush left. -->
                        <TextBlock Text="{Binding DisplayName}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <CheckBox DockPanel.Dock="Top" Content="Exclude already found/hinted"
                  IsChecked="{Binding ExcludeAlreadyFoundOrHinted}"
                  IsVisible="{Binding ShowExcludeCheckbox}"
                  Margin="0,10,0,0"/>

        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search..." Margin="0,10,0,0"/>

        <!-- Declared before the fill area so LastChildFill still applies to it. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="OnCloseClick"/>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <ScrollViewer Classes="dialog-list" IsVisible="{Binding !HasNoRowsAtAll}">
                <ItemsControl ItemsSource="{Binding FilteredRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- Reflection binding so the AncestorType=Window binding resolves
                             SendCommand off the Window's view model without a cast. -->
                        <DataTemplate x:CompileBindings="False">
                            <!-- Deliberately doesn't close the window, so several hints can be sent in a row. -->
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,2,6,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding LoadingText}" Opacity="0.6" IsVisible="{Binding IsLoading}"/>
            <TextBlock Text="Nothing available for this slot/mode."
                       Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding HasNoRowsAtAll}"/>
            <TextBlock Text="Nothing matches your search." Opacity="0.6"
                       IsVisible="{Binding HasNoSearchMatches}"/>
        </Grid>
    </DockPanel>
</Window>
