<!-- Width 460, same as ConnectionEditorWindow/SettingsWindow - see
     Styles/DialogStyles.axaml's "dialog-list" ScrollViewer padding, which
     this window also uses for its group list. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:m="using:Archipolygo.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Archipolygo.Views.PasswordPromptWindow"
        x:DataType="vm:PasswordPromptViewModel"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Passwords needed to connect">

    <Design.DataContext>
        <vm:PasswordPromptViewModel/>
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="These servers need a password before they can connect. Leave a field blank to keep that server disconnected for now."
                   Opacity="0.6" TextWrapping="Wrap"/>

        <!-- Capped height + internal scrolling, same reasoning as
             ConnectionEditorWindow's own lists - several servers needing a
             password at once must not push this window past the screen. -->
        <ScrollViewer MaxHeight="320" Classes="dialog-list">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:PasswordPromptGroupRow">
                        <StackPanel Margin="0,6" Spacing="4">
                            <TextBlock Text="{Binding Group.Name}" FontWeight="Bold"/>

                            <TextBlock Text="Password" Opacity="0.6" IsVisible="{Binding !ShowSlotToggle}"/>
                            <TextBlock Text="Server password (only needed if a slot below has none)"
                                       Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding ShowSlotToggle}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Group.Password}" PasswordChar="*"/>
                                <!-- Collapsed by default - most rooms share
                                     one password for every slot, so this
                                     stays out of the way unless a specific
                                     slot actually needs its own (see
                                     SlotFieldsExpanded's own doc comment).
                                     Same 🔒-toggle convention as
                                     SelectableSlotRow.ShowOverride in the
                                     "Add slot" dialog. -->
                                <ToggleButton Grid.Column="1" Content="🔒" Padding="6,0" Margin="4,0,0,0"
                                              IsChecked="{Binding SlotFieldsExpanded}"
                                              IsVisible="{Binding ShowSlotToggle}"
                                              ToolTip.Tip="Show per-slot passwords"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Slots}" IsVisible="{Binding SlotFieldsExpanded}" Margin="16,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:PasswordPromptSlotRow">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock Text="{Binding Slot.DisplayName, StringFormat='{}{0} password'}" Opacity="0.6"/>
                                            <TextBox Text="{Binding Slot.Password}" PasswordChar="*"/>
                                            <TextBlock Text="Wrong password" Foreground="Red" FontSize="11"
                                                       IsVisible="{Binding ShowError}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancelClick"/>
            <Button Content="Connect" Click="OnConnectClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
