<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Archipolygo.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Archipolygo.Views.ExportServersWindow"
        x:DataType="vm:ExportServersViewModel"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Export servers">

    <!-- Buttons docked below a scrolling body so they stay reachable when DialogScreenFit caps the height. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16" Spacing="8">
            <CheckBox Name="IncludeAppSettingsCheckBox" Content="Include app settings"
                      IsChecked="{Binding IncludeAppSettings}"/>
            <TextBlock Name="ErrorTextBlock" Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
                <Button Name="ExportButton" Content="Export..." Click="OnExportClick" IsDefault="True"
                        IsEnabled="{Binding CanExport}"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Margin="16,16,16,0" Spacing="8">
                <TextBlock Text="Servers to export"/>
                <ItemsControl Name="ServerList" ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportServerRowViewModel">
                            <CheckBox IsChecked="{Binding IsSelected}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{Binding ColorBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HostPort}" Opacity="0.6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
