<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TestHarness.TestHarnessApp"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme/>
        <!-- Same standardized dialog styles as the real app (see
             AvaloniaApplication1/Styles/DialogStyles.axaml) - any prototype
             dialog built here should look like the real dialog it's
             previewing, not drift from it. -->
        <StyleInclude Source="avares://Archipolygo/Styles/DialogStyles.axaml"/>
    </Application.Styles>
</Application>
