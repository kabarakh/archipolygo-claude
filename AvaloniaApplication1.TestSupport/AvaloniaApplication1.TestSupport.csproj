<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Shared fakes (IConnectionManager/IPersistenceService stand-ins) used by
      both TestHarness (manual UI prototyping, see .claude/skills/app-testen)
      and AvaloniaApplication1.Tests (automated tests, see
      Test-Umsetzungsplan.md) - kept in one place so they aren't duplicated
      and maintained twice. Not shipped with the app itself.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaApplication1\AvaloniaApplication1.csproj"/>
  </ItemGroup>

</Project>
