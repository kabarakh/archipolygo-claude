<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe, not the default library output: Avalonia.Headless.XUnit 12.0.4
         pulls in xunit.v3 (via xunit.v3.extensibility.core 3.2.2), whose test
         projects are self-hosting executables (Microsoft.Testing.Platform),
         unlike classic xunit v2/`dotnet new xunit`'s library output - see
         Test-Umsetzungsplan.md's package versions and CLAUDE.md's convention
         of checking the exact pinned package version rather than guessing. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- xunit.v3 3.2.2, not classic xunit(.v2) - must match the
         xunit.v3.extensibility.core version Avalonia.Headless.XUnit 12.0.4
         pins (see its .nuspec); a v2/v3 mix fails with CS0433 (FactAttribute
         defined in both xunit.core and xunit.v3.core). -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaApplication1\AvaloniaApplication1.csproj" />
    <ProjectReference Include="..\AvaloniaApplication1.TestSupport\AvaloniaApplication1.TestSupport.csproj" />
  </ItemGroup>

</Project>